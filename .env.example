[TEMPLATE]
# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=real_estate_ai
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# Authentication
SECRET_KEY=supersecretkey-please-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# OpenAI key used only by the document-embedding pipeline.
LLM_API_KEY=your_openai_embedding_key_here

# Local Sarvam LLM (OpenAI-compatible server exposed by agent/voice/local_llm_server.py)
# Port 8001 avoids the FastAPI backend's default port (8000).
SARVAM_LLM_BASE_URL=http://127.0.0.1:8001/v1
SARVAM_LLM_MODEL=sarvam-1
SARVAM_LLM_API_KEY=local-sarvam

# Hinglish speech pipeline (legacy Whisper/Edge-TTS agent; the realtime agent
# below does not use these, they are kept for agent/voice/custom_stt.py).
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
TTS_VOICE=hi-IN-SwaraNeural
LIVEKIT_AGENT_NAME=deal-closer

# --- Priya realtime sales agent (agent/voice/livekit_agent.py) ---
# Google Gemini Live API voice-to-voice model + female voice.
# NOTE: the realtime model key is LLM_API_KEY above (mapped to GOOGLE_API_KEY).
GEMINI_REALTIME_MODEL=gemini-2.0-flash-exp
GEMINI_VOICE=Aoede
# Which project the agent should pitch by default. Leave empty to search
# properties across ALL projects in the CRM.
DEFAULT_PROJECT_ID=
# Text model used to summarize call transcripts on call end (optional; falls
# back to a rule-based summary if unset or the call fails).
SUMMARY_MODEL=gemini-2.5-flash-lite

# LiveKit (Voice)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
